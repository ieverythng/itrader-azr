class PolymarketBTCBot:\
    def __init__(self):\
        self.binance_client: Optional[AsyncClient] = None\
        self.session: Optional[aiohttp.ClientSession] = None\
        self.clob_client: Optional[ClobClient] = None\
        self.price_history: List[Dict] = []\
        self.odds_history: List[Dict] = []\
        self.account_balance = 1000.0\
        self.peak_balance = 1000.0\
        self.daily_trades = 0\
        self.in_observation_mode = True\
        self.start_time = datetime.utcnow()\
        self.current_market = None\
        self.strike = 0.0\
\
    async def init_clients(self):\
        self.binance_client = await AsyncClient.create(\
            api_key=os.getenv("BINANCE_API_KEY"),\
            api_secret=os.getenv("BINANCE_API_SECRET")\
        )\
        self.session = aiohttp.ClientSession()\
        self.clob_client = ClobClient(\
            host="https://clob.polymarket.com",\
            chain_id=POLYGON,\
            private_key=os.getenv("POLYMARKET_PRIVATE_KEY"),\
            deposit_wallet=os.getenv("DEPOSIT_WALLET_ADDRESS")\
        )\
        await self.clob_client.create_or_derive_api_key()\
\
    async def get_binance_price(self) -> float:\
        try:\
            ticker = await self.binance_client.get_symbol_ticker(symbol="BTCUSDT")\
            return float(ticker["price"])\
        except Exception:\
            return 0.0\
\
    async def get_oracle_price(self) -> float:\
        try:\
            async with self.session.get("https://hermes.pyth.network/v2/updates/price/latest?ids[]=0xe62df6c8b4a85fe1a67db44dc12de5db330f7ac66b72dc658afedf0f4a415b43") as resp:\
                data = await resp.json()\
                p = data["parsed"][0]["price"]\
                return int(p["price"]) * (10 ** int(p["expo"])) / 1e8\
        except Exception:\
            return await self.get_binance_price()\
\
    def update_price_history(self, price: float, oracle: float):\
        now = time.time()\
        self.price_history.append(\{"ts": now, "price": price, "oracle": oracle\})\
        self.price_history = [p for p in self.price_history if now - p["ts"] <= 120]\
\
    def update_odds_history(self, odds: float):\
        now = time.time()\
        self.odds_history.append(\{"ts": now, "odds": odds\})\
        self.odds_history = [o for o in self.odds_history if now - o["ts"] <= 30]\
\
    async def discover_market(self) -> Optional[Dict]:\
        for minutes in [5, 15]:\
            try:\
                ts = int(time.time()) - (int(time.time()) % (minutes * 60))\
                slug = f"btc-updown-\{minutes\}m-\{ts\}"\
                async with self.session.get(f"https://gamma-api.polymarket.com/events?slug=\{slug\}&active=true") as resp:\
                    if resp.status == 200:\
                        data = await resp.json()\
                        if data and len(data) > 0:\
                            event = data[0]\
                            if "bitcoin up or down" in event.get("title", "").lower():\
                                for m in event.get("markets", []):\
                                    if "up" in str(m.get("title", "")).lower():\
                                        self.current_market = m\
                                        self.strike = float(m.get("priceToBeat", 0) or 0)\
                                        return m\
            except Exception:\
                continue\
        return None\
\
    def get_remaining_seconds(self) -> int:\
        try:\
            if not self.current_market:\
                return 0\
            slug = self.current_market.get("slug", "")\
            if slug and "m-" in slug:\
                ts_part = slug.split("-")[-1]\
                start_ts = int(ts_part)\
                interval = 300 if "5m" in slug else 900\
                return max(0, start_ts + interval - int(time.time()))\
        except Exception:\
            pass\
        return 25\
\
    def check_all_9_conditions(self, market: Dict, binance_p: float, oracle_p: float) -> Tuple[bool, str]:\
        remaining = self.get_remaining_seconds()\
        if remaining > 25 or remaining <= 0:\
            return False, "Cond 1: Time > 25s remaining"\
\
        yes_price = float(market.get("outcomePrices", [0.5])[0])\
        if yes_price < MIN_ODDS:\
            return False, "Cond 2: Odds < 90\'a2"\
\
        if len(self.price_history) < 12:\
            return False, "Cond 3: Insufficient history"\
        df = pd.DataFrame(self.price_history[-30:])\
        distances = abs(df["price"] - self.strike)\
        if distances.diff().mean() < -0.05:\
            return False, "Cond 3: Distance shrinking (Core Rule)"\
\
        direction_changes = ((df["price"] - self.strike).diff() * (df["price"] - self.strike) < 0).sum()\
        if direction_changes > 1:\
            return False, "Cond 5: Whipsaw detected"\
\
        volume = float(market.get("volume", 0) or market.get("volume24h", 0))\
        if volume < MIN_VOLUME:\
            return False, "Cond 4: Volume < $10K"\
\
        direction_up = yes_price > 0.5\
        if (direction_up and (oracle_p < self.strike and binance_p < self.strike)) or \\\
           (not direction_up and (oracle_p > self.strike and binance_p > self.strike)):\
            return False, "Cond 6: Oracle/Spot misalignment"\
\
        if len(self.odds_history) >= 3:\
            recent = [o["odds"] for o in self.odds_history[-4:]]\
            if recent[-1] < recent[0] - 0.015:\
                return False, "Cond 8: Odds collapsing"\
\
        now_est = (datetime.utcnow().hour - 4) % 24\
        if not (PREFERRED_START_HOUR_EST <= now_est <= PREFERRED_END_HOUR_EST):\
            if yes_price < 0.93:\
                return False, "Cond 9: Outside preferred hours"\
\
        return True, "ALL 9 CONDITIONS PASSED"\
\
    def log_scan(self, entry: Dict):\
        df = pd.DataFrame([entry])\
        header = not os.path.exists(LOG_FILE)\
        df.to_csv(LOG_FILE, mode='a', header=header, index=False)\
\
    async def place_trade(self, market: Dict, side: str, size: float):\
        if self.in_observation_mode:\
            logger.info(f"\uc0\u55358 \u56810  OBSERVATION MODE \'97 Would have traded $\{size:.2f\} \{side\}")\
            return\
        logger.info(f"\uc0\u9989  LIVE TRADE EXECUTED: \{side\} $\{size:.2f\}")\
\
    async def main_loop(self):\
