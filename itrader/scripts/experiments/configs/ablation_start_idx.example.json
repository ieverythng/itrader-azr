{
  "name": "lr_ablation_stream",
  "python_exe": "python",
  "train_module": "itrader.rl_lib.train.train_solo_V2",
  "common_args": {
    "iters": 30,
    "workers": 6,
    "timeout_hours": 1,
    "window": 60,
    "gamma": 0.99,
    "lambda": 0.95,
    "train_batch_size": 4800,
    "sgd_minibatch_size": 128,
    "num_sgd_iter": 30,
    "vf_clip_param": 10.0,
    "clip_param": 0.2,
    "vf_loss_coeff": 1.0,
    "data_path": "itrader/data/ohlcv.parquet",
    "stream_jump_on_wrap": true
  },
  "variants": [
    {
      "id": "lr_0.005",
      "args": {
        "start_idx_mode": "stream_worker",
        "ret_norm_reset": "episode",
        "stream_stride": 0,
        "stream_jump_every_episodes": 0,
        "lr": 0.005
      }
    },
    {
      "id": "lr_0.0005",
      "args": {
        "start_idx_mode": "stream_worker",
        "ret_norm_reset": "stream",
        "stream_stride": 0,
        "stream_jump_every_episodes": 0,
        "lr": 0.0005
      }
    }
  ]
}
