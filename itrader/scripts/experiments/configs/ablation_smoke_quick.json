{
  "name": "Phase_A_Smoke_Ablation",
  "python_exe": "python",
  "train_module": "itrader.rl_lib.train.train_solo_V2",
  "common_args": {
    "cpu_pbt": true,
    "iters": 3,
    "workers": 2,
    "timeout_hours": 1,
    "window": 30,
    "seed": 2027,
    "gamma": 0.99,
    "lambda": 0.95,
    "lr": 0.00005,
    "train_batch_size": 4800,
    "sgd_minibatch_size": 128,
    "num_sgd_iter": 30,
    "vf_clip_param": 10.0,
    "clip_param": 0.2,
    "vf_loss_coeff": 1.0,
    "data_path": "itrader/data/ohlcv.parquet",
    "stream_jump_on_wrap": true,
    "auto_plot_on_end": true
  },
  "variants": [
    {
      "id": "random_episode_reset_episode",
      "args": {
        "start_idx_mode": "random_episode",
        "ret_norm_reset": "episode",
        "stream_stride": 0,
        "stream_jump_every_episodes": 0
      }
    },
    {
      "id": "stream_worker_reset_stream_jump5",
      "args": {
        "start_idx_mode": "stream_worker",
        "ret_norm_reset": "stream",
        "stream_stride": 0,
        "stream_jump_every_episodes": 5
      }
    }
  ]
}
